# Copia este archivo como .env para desarrollo local (no lo subas nunca con la clave real).
# En Render.com, esta variable se configura en el panel del servicio, no en el repositorio.

# Clave gratuita de Google Gemini (Google AI Studio → "Crear clave de API").
# Sin ella, el asistente responde con un mensaje amable de "configurándose".
GEMINI_API_KEY=

PORT=3000
